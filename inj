-- SHA256
local function sha256(message)
    local bit = bit32 or bit

    local h = {
        0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a,
        0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19
    }

    local k = {
        0x428a2f98,0x71374491,0xb5c0fbcf,0xe9b5dba5,
        0x3956c25b,0x59f111f1,0x923f82a4,0xab1c5ed5,
        0xd807aa98,0x12835b01,0x243185be,0x550c7dc3,
        0x72be5d74,0x80deb1fe,0x9bdc06a7,0xc19bf174,
        0xe49b69c1,0xefbe4786,0x0fc19dc6,0x240ca1cc,
        0x2de92c6f,0x4a7484aa,0x5cb0a9dc,0x76f988da,
        0x983e5152,0xa831c66d,0xb00327c8,0xbf597fc7,
        0xc6e00bf3,0xd5a79147,0x06ca6351,0x14292967,
        0x27b70a85,0x2e1b2138,0x4d2c6dfc,0x53380d13,
        0x650a7354,0x766a0abb,0x81c2c92e,0x92722c85,
        0xa2bfe8a1,0xa81a664b,0xc24b8b70,0xc76c51a3,
        0xd192e819,0xd6990624,0xf40e3585,0x106aa070,
        0x19a4c116,0x1e376c08,0x2748774c,0x34b0bcb5,
        0x391c0cb3,0x4ed8aa4a,0x5b9cca4f,0x682e6ff3,
        0x748f82ee,0x78a5636f,0x84c87814,0x8cc70208,
        0x90befffa,0xa4506ceb,0xbef9a3f7,0xc67178f2
    }

    local function rrotate(x, n)
        return bit.rrotate(x, n)
    end

    local len = #message
    message = message .. "\128"

    while #message % 64 ~= 56 do
        message = message .. "\0"
    end

    local bits = len * 8

    for i = 7, 0, -1 do
        message = message .. string.char(
            math.floor(bits / 2^(i * 8)) % 256
        )
    end

    for offset = 1, #message, 64 do
        local w = {}

        for i = 0, 15 do
            local a, b, c, d = message:byte(
                offset + i * 4,
                offset + i * 4 + 3
            )

            w[i] = ((a * 256 + b) * 256 + c) * 256 + d
        end

        for i = 16, 63 do
            local x, y = w[i - 15], w[i - 2]

            local s0 = bit.bxor(rrotate(x, 7), rrotate(x, 18), bit.rshift(x, 3))
            local s1 = bit.bxor(rrotate(y, 17), rrotate(y, 19), bit.rshift(y, 10))

            w[i] = (w[i - 16] + s0 + w[i - 7] + s1) % 2^32
        end

        local a, b, c, d, e, f, g, hh =
            h[1], h[2], h[3], h[4], h[5], h[6], h[7], h[8]

        for i = 0, 63 do
            local S1 = bit.bxor(rrotate(e, 6), rrotate(e, 11), rrotate(e, 25))
            local ch = bit.bxor(bit.band(e, f), bit.band(bit.bnot(e), g))
            local temp1 = (hh + S1 + ch + k[i + 1] + w[i]) % 2^32

            local S0 = bit.bxor(rrotate(a, 2), rrotate(a, 13), rrotate(a, 22))
            local maj = bit.bxor(bit.band(a, b), bit.band(a, c), bit.band(b, c))
            local temp2 = (S0 + maj) % 2^32

            hh, g, f, e, d, c, b, a =
                g, f, e, (d + temp1) % 2^32,
                c, b, a, (temp1 + temp2) % 2^32
        end

        local values = {a, b, c, d, e, f, g, hh}

        for i = 1, 8 do
            h[i] = (h[i] + values[i]) % 2^32
        end
    end

    local result = ""

    for i = 1, 8 do
        result = result .. string.format("%08x", h[i])
    end

    return result
end

local function getHWID()
    return sha256(getIdentifier())
end

-- NONCE
local function generateNonce()
    local chars = "abcdefghijklmnopqrstuvwxyz"
    local nonce = ""

    for i = 1, 16 do
        local index = math.random(1, #chars)
        nonce = nonce .. chars:sub(index, index)
    end

    return nonce
end

-- CONNECTIVITE (avec fallback .net comme le 1er script)
local function checkConnectivity()
    local response = safeRequest({Url = host .. "/public/connectivity", Method = "GET"})

    if not response or (response.StatusCode ~= 200 and response.StatusCode ~= 429) then
        host = "https://api.platoboost.net"
        local fallback = safeRequest({Url = host .. "/public/connectivity", Method = "GET"})
        if not fallback then
            return false
        end
    end

    return true
end

-- GET KEY LINK (avec cache 10 min)
local cachedLink, cachedTime = "", 0

local function cacheLink()
    if not checkConnectivity() then
        return false, "Network error! Use VPN or change executor."
    end

    if cachedTime + (10 * 60) < os.time() then
        local response, err = safeRequest({
            Url = host .. "/public/start",
            Method = "POST",
            Headers = {["Content-Type"] = "application/json"},
            Body = HttpService:JSONEncode({
                service = Config.ServiceId,
                identifier = getHWID()
            })
        })

        if response and response.StatusCode == 200 then
            local ok, data = pcall(function()
                return HttpService:JSONDecode(response.Body)
            end)

            if ok and data.success then
                cachedLink = data.data.url
                cachedTime = os.time()
                return true, cachedLink
            end
        end

        return false, err or "Unable to get link"
    end

    return true, cachedLink
end

-- REDEEM KEY
local function redeemKey(key)
    local nonce = generateNonce()

    local body = {
        identifier = getHWID(),
        key = key
    }

    if useNonce then
        body.nonce = nonce
    end

    local response, err = safeRequest({
        Url = host .. "/public/redeem/" .. tostring(Config.ServiceId),
        Method = "POST",
        Headers = {["Content-Type"] = "application/json"},
        Body = HttpService:JSONEncode(body)
    })

    if response and response.StatusCode == 200 then
        local ok, data = pcall(function()
            return HttpService:JSONDecode(response.Body)
        end)

        if not ok then
            return false, "Server Error"
        end

        if data.success and data.data and data.data.valid then
            if useNonce then
                local expected = sha256("true" .. "-" .. nonce .. "-" .. Config.PlatoSecret)

                if data.data.hash ~= expected then
                    return false, "Integrity Check Failed"
                end
            end

            if writefile then
                pcall(writefile, Config.KeyFileName, key)
            end

            return true, "Success"
        end

        return false, data.message or "Invalid Key"
    end

    return false, err or "Server Error"
end

