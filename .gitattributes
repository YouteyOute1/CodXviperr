-- 1. DÉTECTION ÉTAT ATM & REGISTER
local function isATMBroken(atmObj)
	local health = atmObj:GetAttribute("Health")
	if health and typeof(health) == "number" and health <= 1 then return true end
	local isOpen = atmObj:GetAttribute("Open")
	if isOpen == true then return true end
	local brokenVal = atmObj:FindFirstChild("Broken") or atmObj:FindFirstChild("IsBroken")
	if brokenVal and (brokenVal.Value == true or brokenVal.Value == 1) then return true end
	return false
end

local function getRegisterModel(obj)
	local current = obj
	while current and current ~= Workspace do
		if current.Name == "Register" and current:IsA("Model") then
			return current
		end
		current = current.Parent
	end
	return nil
end

local function isRegisterOpened(regModel)
	if not regModel or not regModel.Parent then return true end
	for attrName, val in pairs(regModel:GetAttributes()) do
		local n = attrName:lower()
		if (n:find("open") or n:find("broken") or n:find("used")) and val == true then return true end
	end
	local door = regModel:FindFirstChild("Door")
	if door and door:IsA("BasePart") then
		local initialCFrame = registerInitialDoors[regModel]
		if initialCFrame then
			local distance = (door.Position - initialCFrame.Position).Magnitude
			if distance > 0.2 then return true end
		end
	end
	return false
end

-- 2. FILTRAGE ET HIGHLIGHTS
local function shouldIgnoreCandy(obj)
	local fullName = obj.Name:lower()
	for _, descendant in ipairs(obj:GetDescendants()) do
		if descendant:IsA("TextLabel") then
			local text = descendant.Text:lower()
			if text:find("-$7") or text:find("7") then return true end
		end
	end
	if fullName:find("-$7") or fullName:find("7") then return true end
	return false
end

local function isPickableCash(obj)
	if shouldIgnoreCandy(obj) then return false end
	if obj:FindFirstChildOfClass("ProximityPrompt") or obj:FindFirstChildOfClass("ClickDetector") then return true end
	if obj.Parent and (obj.Parent:FindFirstChildOfClass("ProximityPrompt") or obj.Parent:FindFirstChildOfClass("ClickDetector")) then return true end
	return false
end

local function applyHighlight(obj, fillColor)
	if not (obj:IsA("Model") or obj:IsA("BasePart")) then return end
	local highlight = obj:FindFirstChild("Master_HL")
	if not highlight then
		highlight = Instance.new("Highlight")
		highlight.Name = "Master_HL"
		highlight.FillTransparency = 0.25
		highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
		highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		highlight.Parent = obj
		table.insert(activeHighlights, highlight)
	end
	highlight.FillColor = fillColor
end

local function processObject(obj)
	if not isMapInvisible then return end
	local name = obj.Name:lower()

	-- ATM
	if name == "atm" or name == "atms" then
		local color = isATMBroken(obj) and Color3.fromRGB(255, 140, 0) or Color3.fromRGB(0, 255, 128)
		applyHighlight(obj, color)
		local c1 = obj:GetAttributeChangedSignal("Health"):Connect(function()
			if isMapInvisible then applyHighlight(obj, isATMBroken(obj) and Color3.fromRGB(255, 140, 0) or Color3.fromRGB(0, 255, 128)) end
		end)
		table.insert(activeConnections, c1)

	-- REGISTER
	else
		local reg = getRegisterModel(obj)
		if reg then
			local door = reg:FindFirstChild("Door")
			if door and door:IsA("BasePart") and not registerInitialDoors[reg] then
				registerInitialDoors[reg] = door.CFrame
			end
			if obj:IsA("UnionOperation") and obj.Material == Enum.Material.SmoothPlastic then
				local color = isRegisterOpened(reg) and Color3.fromRGB(255, 140, 0) or Color3.fromRGB(0, 255, 128)
				applyHighlight(obj, color)
			end
		elseif name:find("candycash") or name:find("candy") or name:find("cash") or name:find("money") then
			task.delay(0.15, function()
				if isMapInvisible and obj and obj.Parent and isPickableCash(obj) then
					applyHighlight(obj, Color3.fromRGB(0, 255, 128))
				end
			end)
		end
	end
end

-- 3. X-RAY CONTROL
local function setMapInvisibility(enable)
	if enable then
		originalTransparencies = {}
		activeConnections = {}

		for _, part in ipairs(Workspace:GetDescendants()) do
			if part:IsA("BasePart") and not part:IsDescendantOf(LocalPlayer.Character) then
				local isPlayerChar = Players:GetPlayerFromCharacter(part.Parent) or Players:GetPlayerFromCharacter(part.Parent.Parent)
				local name = part.Name:lower()
				local reg = getRegisterModel(part)
				local isProtected = name:find("atm") or reg or ( (name:find("candy") or name:find("cash")) and isPickableCash(part) )
				
				if not isPlayerChar and not isProtected then
					originalTransparencies[part] = part.Transparency
					part.LocalTransparencyModifier = 0.85
				end
			end
		end

		for _, obj in ipairs(Workspace:GetDescendants()) do processObject(obj) end
		local conn = Workspace.DescendantAdded:Connect(function(obj) processObject(obj) end)
		table.insert(activeConnections, conn)
	else
		for _, conn in ipairs(activeConnections) do
			if typeof(conn) == "RBXScriptConnection" then conn:Disconnect() end
		end
		activeConnections = {}

		for part, originalTransparency in pairs(originalTransparencies) do
			if part and part.Parent then part.LocalTransparencyModifier = 0 end
		end
		originalTransparencies = {}

		for _, desc in ipairs(Workspace:GetDescendants()) do
			local hl = desc:FindFirstChild("Master_HL")
			if hl then hl:Destroy() end
		end
		activeHighlights = {}
	end
end

